# Copie para .env e preencha. NUNCA commite o .env.
# Supabase: Project Settings > Database > Connection string / API

# Runtime (pooler, porta 6543, transaction mode)
DATABASE_URL="postgresql://postgres.PROJECT_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migrations (conexao direta ou session pooler porta 5432)
DIRECT_URL="postgresql://postgres.PROJECT_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"

# Publicas (podem ir ao navegador)
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-anon-ou-publishable-key"

# URL publica do app, usada nos links enviados por e-mail
SITE_URL="http://localhost:3000"

# WhatsApp Cloud API (Fase 6). Numero publico usado no link wa.me, so digitos.
WHATSAPP_DISPLAY_NUMBER=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v27.0"

# Agente de IA (Fase 7): qualquer API compativel com OpenAI. Sem AI_API_KEY, so comandos.
AI_BASE_URL="https://api.groq.com/openai/v1"
AI_MODEL="openai/gpt-oss-120b"

# SECRETAS - somente servidor, nunca com prefixo NEXT_PUBLIC_
# SUPABASE_SERVICE_ROLE_KEY=""
# AI_API_KEY=""
# CRON_SECRET="" # protege /api/cron/whatsapp-retry
# WHATSAPP_VERIFY_TOKEN=""
# WHATSAPP_APP_SECRET=""
# WHATSAPP_ACCESS_TOKEN=""
